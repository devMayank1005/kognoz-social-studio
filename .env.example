# Anthropic
ANTHROPIC_API_KEY=

# Supabase (Postgres) — server-side only, service role key never reaches the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Microsoft 365 (Azure AD / Entra ID) SSO
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=2dbb05c9-b19f-4164-bc87-9a3f87e7d02e

# Supabase Client Keys (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Who may read the activity trail at /admin/activity — comma-separated addresses.
# UNSET MEANS NOBODY, deliberately: a deploy that forgets this variable must not
# publish every person's IP address and movements to anyone who can sign in.
#
# It is an env list rather than users.role because Microsoft SSO users have no row
# in the `users` table at all, so the database cannot answer the question for them.
ADMIN_EMAILS=mayank@kognozconsulting.com
