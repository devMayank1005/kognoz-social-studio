# Anthropic
ANTHROPIC_API_KEY=

# Supabase (Postgres) — server-side only, service role key never reaches the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# No provider env vars needed — auth is username/password (Credentials
# provider) checked against the `users` table in Supabase. That table IS the
# allowlist. Add people with: npm run add-user "<email>" "<name>" "<password>"
